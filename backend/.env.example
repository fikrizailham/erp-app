DATABASE_URL="postgresql://postgres:postgres@localhost:5432/daycare_erp?schema=public"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# S3-compatible object storage (MinIO locally, S3/R2/Spaces in prod)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="daycare-erp-files"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"

# Push notifications (Expo Push / Firebase Cloud Messaging)
EXPO_ACCESS_TOKEN=""
FCM_SERVER_KEY=""
