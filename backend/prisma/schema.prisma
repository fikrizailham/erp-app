// Bluma Juice Cold Press — ERP + POS
// Prisma schema — PostgreSQL
// Covers: Auth/RBAC, Products, BOM, Manufacturing, Batch/Expiry Tracking,
// Inventory (multi-warehouse), Purchasing, POS/Sales, CRM/Loyalty,
// Subscriptions, Delivery, Marketplace, Waste, Accounting.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================================
// ENUMS
// =========================================================================

enum UserRole {
  ADMIN
  MANAGER
  PRODUCTION_STAFF
  WAREHOUSE_STAFF
  CASHIER
  SALES
  ACCOUNTANT
  DRIVER
}

enum RawMaterialCategory {
  FRUIT
  VEGETABLE
  HONEY
  GINGER
  MINT_LEAVES
  BOTTLE
  CAP
  LABEL
  PACKAGING
  OTHER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum SupplierType {
  FRUIT
  VEGETABLE
  PACKAGING
  OTHER
}

enum WarehouseType {
  RAW_MATERIAL
  PRODUCTION
  FINISHED_GOODS
  OUTLET
}

enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CONVERTED
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SupplierInvoiceStatus {
  UNPAID
  PAID
  OVERDUE
}

enum ProductionOrderStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BatchStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  DEPLETED
  RECALLED
}

enum StockMovementType {
  GOODS_RECEIPT
  PRODUCTION_ISSUE
  PRODUCTION_RECEIPT
  TRANSFER
  ADJUSTMENT
  SALE
  WASTE
  OPNAME
}

enum StockItemType {
  RAW_MATERIAL
  FINISHED_GOODS
}

enum SaleChannel {
  WALK_IN
  ONLINE
  WHATSAPP
  MARKETPLACE
  CORPORATE
  RESELLER
}

enum PaymentMethod {
  CASH
  QRIS
  EWALLET
  CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  REFUNDED
  VOID
}

enum CustomerType {
  WALK_IN
  MEMBER
  CORPORATE
  RESELLER
}

enum CouponDiscountType {
  PERCENT
  FIXED
}

enum SubscriptionFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum DeliveryStatus {
  SCHEDULED
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

enum WasteType {
  RAW_MATERIAL
  FINISHED_GOODS
}

enum WasteReason {
  EXPIRED
  ROTTEN
  DAMAGED
  PRODUCTION_LOSS
  QUALITY_REJECT
  OTHER
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
  COGS
}

enum JournalSourceType {
  PURCHASE
  PRODUCTION
  SALE
  WASTE
  ADJUSTMENT
  MANUAL
}

enum MarketplaceName {
  TOKOPEDIA
  SHOPEE
  TIKTOK_SHOP
}

enum StockOpnameStatus {
  DRAFT
  COMPLETED
}

// =========================================================================
// AUTH / USERS
// =========================================================================

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // relations (back references only, no FK columns here)
  productionOrdersOperated ProductionOrder[]  @relation("Operator")
  sales                    Sale[]
  wasteRecordsRecorded     WasteRecord[]
  deliveriesAsDriver       Delivery[]         @relation("DriverUser")
  journalEntriesCreated    JournalEntry[]
  refreshTokens            RefreshToken[]

  @@index([role])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)
}

// =========================================================================
// PRODUCT MANAGEMENT (Finished Goods)
// =========================================================================

model Product {
  id            String        @id @default(uuid())
  sku           String        @unique
  barcode       String?       @unique
  name          String
  size          String // e.g. "250ml", "500ml"
  unit          String        @default("bottle")
  sellingPrice  Decimal       @db.Decimal(12, 2)
  shelfLifeDays Int // days from production to expiry
  category      String? // e.g. Detox, Green, Mixed Fruit, Seasonal
  status        ProductStatus @default(ACTIVE)
  imageUrl      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  recipes            Recipe[]
  productionOrders    ProductionOrder[]
  batches             FinishedGoodsBatch[]
  saleItems           SaleItem[]
  subscriptionItems   SubscriptionItem[]
  productionPlanItems ProductionPlanItem[]

  @@index([status])
}

// =========================================================================
// RECIPE MANAGEMENT (BOM)
// =========================================================================

model Recipe {
  id               String   @id @default(uuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  name             String
  version          Int      @default(1)
  standardYieldQty Decimal  @db.Decimal(12, 3) // expected output quantity (units of product)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ingredients      RecipeIngredient[]
  productionOrders ProductionOrder[]

  @@index([productId])
}

model RecipeIngredient {
  id             String       @id @default(uuid())
  recipeId       String
  recipe         Recipe       @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  rawMaterialId  String
  rawMaterial    RawMaterial  @relation(fields: [rawMaterialId], references: [id])
  quantity       Decimal      @db.Decimal(12, 3) // quantity per standard yield batch
  unit           String

  @@index([recipeId])
}

// =========================================================================
// RAW MATERIALS & SUPPLIERS
// =========================================================================

model RawMaterial {
  id             String               @id @default(uuid())
  sku            String               @unique
  name           String
  category       RawMaterialCategory
  unit           String // kg, g, pcs, liter
  minStockLevel  Decimal              @db.Decimal(12, 3) @default(0)
  shelfLifeDays  Int? // null = non-perishable (e.g. bottles, caps)
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  recipeIngredients        RecipeIngredient[]
  supplierRawMaterials     SupplierRawMaterial[]
  priceHistory              PriceHistory[]
  purchaseRequestItems      PurchaseRequestItem[]
  purchaseOrderItems        PurchaseOrderItem[]
  goodsReceiptItems         GoodsReceiptItem[]
  lots                       RawMaterialLot[]
  productionIssues           ProductionOrderIngredientIssue[]
  wasteRecords                WasteRecord[]

  @@index([category])
}

model Supplier {
  id            String       @id @default(uuid())
  name          String
  type          SupplierType
  contactName   String?
  phone         String?
  email         String?
  address       String?
  leadTimeDays  Int?
  rating        Decimal?     @db.Decimal(3, 2) // 0.00 - 5.00, derived from performance
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  rawMaterials     SupplierRawMaterial[]
  priceHistory     PriceHistory[]
  purchaseOrders   PurchaseOrder[]
  goodsReceipts    RawMaterialLot[]
  invoices         SupplierInvoice[]

  @@index([type])
}

model SupplierRawMaterial {
  id            String      @id @default(uuid())
  supplierId    String
  supplier      Supplier    @relation(fields: [supplierId], references: [id])
  rawMaterialId String
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])
  currentPrice  Decimal     @db.Decimal(12, 2)
  leadTimeDays  Int?

  @@unique([supplierId, rawMaterialId])
}

model PriceHistory {
  id            String      @id @default(uuid())
  supplierId    String
  supplier      Supplier    @relation(fields: [supplierId], references: [id])
  rawMaterialId String
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])
  price         Decimal     @db.Decimal(12, 2)
  effectiveDate DateTime    @default(now())

  @@index([rawMaterialId, effectiveDate])
}

// =========================================================================
// WAREHOUSES & INVENTORY (with batch/lot tracking)
// =========================================================================

model Warehouse {
  id        String        @id @default(uuid())
  name      String
  type      WarehouseType
  address   String?
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())

  rawMaterialLots       RawMaterialLot[]
  finishedGoodsStocks   FinishedGoodsStock[]
  productionOrders      ProductionOrder[]
  goodsReceipts         GoodsReceipt[]
  salesAsOutlet         Sale[]
  stockMovementsFrom    StockMovement[]      @relation("FromWarehouse")
  stockMovementsTo      StockMovement[]      @relation("ToWarehouse")
  stockOpnames          StockOpname[]

  @@index([type])
}

/// A received lot of a raw material — the batch/traceability unit for raw materials.
model RawMaterialLot {
  id                String      @id @default(uuid())
  lotNumber         String      @unique
  rawMaterialId     String
  rawMaterial       RawMaterial @relation(fields: [rawMaterialId], references: [id])
  supplierId        String
  supplier          Supplier    @relation(fields: [supplierId], references: [id])
  warehouseId       String
  warehouse         Warehouse   @relation(fields: [warehouseId], references: [id])
  goodsReceiptItemId String?    @unique
  goodsReceiptItem   GoodsReceiptItem? @relation(fields: [goodsReceiptItemId], references: [id])
  quantityReceived  Decimal     @db.Decimal(12, 3)
  quantityRemaining Decimal     @db.Decimal(12, 3)
  unitCost          Decimal     @db.Decimal(12, 2)
  receivedDate      DateTime    @default(now())
  expiryDate        DateTime?
  createdAt         DateTime    @default(now())

  productionIssues ProductionOrderIngredientIssue[]
  wasteRecords     WasteRecord[]

  @@index([rawMaterialId, expiryDate])
  @@index([warehouseId])
}

/// Every production run creates a Finished Goods Batch — the core traceability unit.
model FinishedGoodsBatch {
  id                 String        @id @default(uuid())
  batchNumber        String        @unique // e.g. BLM240701A
  productId          String
  product            Product       @relation(fields: [productId], references: [id])
  productionOrderId  String        @unique
  productionOrder    ProductionOrder @relation(fields: [productionOrderId], references: [id])
  productionDate     DateTime
  expiryDate         DateTime
  quantityProduced   Decimal       @db.Decimal(12, 3)
  unitCost           Decimal       @db.Decimal(12, 2) @default(0) // ingredient cost per unit, for COGS at point of sale
  status             BatchStatus   @default(ACTIVE)
  createdAt          DateTime      @default(now())

  stocks    FinishedGoodsStock[]
  saleItems SaleItem[]
  wasteRecords WasteRecord[]

  @@index([productId, expiryDate])
  @@index([status])
}

/// Quantity of a finished-goods batch currently sitting in a given warehouse.
model FinishedGoodsStock {
  id          String              @id @default(uuid())
  batchId     String
  batch       FinishedGoodsBatch  @relation(fields: [batchId], references: [id])
  warehouseId String
  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id])
  quantity    Decimal             @db.Decimal(12, 3)
  updatedAt   DateTime            @updatedAt

  @@unique([batchId, warehouseId])
  @@index([warehouseId])
}

/// Unified stock ledger — every inventory-affecting event, for full auditability.
model StockMovement {
  id               String            @id @default(uuid())
  type             StockMovementType
  itemType         StockItemType
  rawMaterialLotId String?
  finishedGoodsBatchId String?
  fromWarehouseId  String?
  fromWarehouse    Warehouse?        @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouseId    String?
  toWarehouse      Warehouse?        @relation("ToWarehouse", fields: [toWarehouseId], references: [id])
  quantity         Decimal           @db.Decimal(12, 3)
  reference        String? // e.g. sale number, PO number, production order number
  note             String?
  createdById      String?
  createdAt        DateTime          @default(now())

  @@index([itemType, rawMaterialLotId])
  @@index([itemType, finishedGoodsBatchId])
  @@index([createdAt])
}

model StockOpname {
  id           String            @id @default(uuid())
  opnameNumber String            @unique
  warehouseId  String
  warehouse    Warehouse         @relation(fields: [warehouseId], references: [id])
  date         DateTime          @default(now())
  status       StockOpnameStatus @default(DRAFT)
  createdById  String?
  createdAt    DateTime          @default(now())

  lines StockOpnameLine[]
}

model StockOpnameLine {
  id                   String        @id @default(uuid())
  opnameId             String
  opname               StockOpname   @relation(fields: [opnameId], references: [id], onDelete: Cascade)
  itemType             StockItemType
  rawMaterialLotId     String?
  finishedGoodsBatchId String?
  systemQty            Decimal       @db.Decimal(12, 3)
  countedQty           Decimal       @db.Decimal(12, 3)
  variance             Decimal       @db.Decimal(12, 3)

  @@index([opnameId])
}

// =========================================================================
// PURCHASING
// =========================================================================

model PurchaseRequest {
  id            String                @id @default(uuid())
  requestNumber String                @unique
  requestedById String?
  status        PurchaseRequestStatus @default(DRAFT)
  notes         String?
  createdAt     DateTime              @default(now())

  items          PurchaseRequestItem[]
  purchaseOrders PurchaseOrder[]
}

model PurchaseRequestItem {
  id                String          @id @default(uuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  rawMaterialId     String
  rawMaterial       RawMaterial     @relation(fields: [rawMaterialId], references: [id])
  quantity          Decimal         @db.Decimal(12, 3)
  neededBy          DateTime?
}

model PurchaseOrder {
  id                String              @id @default(uuid())
  poNumber          String              @unique
  supplierId        String
  supplier          Supplier            @relation(fields: [supplierId], references: [id])
  purchaseRequestId String?
  purchaseRequest   PurchaseRequest?    @relation(fields: [purchaseRequestId], references: [id])
  status            PurchaseOrderStatus @default(DRAFT)
  orderDate         DateTime            @default(now())
  expectedDate      DateTime?
  createdById       String?
  createdAt         DateTime            @default(now())

  items          PurchaseOrderItem[]
  goodsReceipts  GoodsReceipt[]
  invoices       SupplierInvoice[]
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  rawMaterialId   String
  rawMaterial     RawMaterial   @relation(fields: [rawMaterialId], references: [id])
  quantity        Decimal       @db.Decimal(12, 3)
  unitPrice       Decimal       @db.Decimal(12, 2)

  goodsReceiptItems GoodsReceiptItem[]
}

model GoodsReceipt {
  id          String    @id @default(uuid())
  grNumber    String    @unique
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  receivedById String?
  receivedDate DateTime @default(now())

  items GoodsReceiptItem[]
}

model GoodsReceiptItem {
  id                String        @id @default(uuid())
  goodsReceiptId    String
  goodsReceipt      GoodsReceipt  @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  rawMaterialId     String
  rawMaterial       RawMaterial   @relation(fields: [rawMaterialId], references: [id])
  quantityOrdered   Decimal       @db.Decimal(12, 3)
  quantityReceived  Decimal       @db.Decimal(12, 3)
  unitCost          Decimal       @db.Decimal(12, 2)
  expiryDate        DateTime?

  rawMaterialLot RawMaterialLot?
}

model SupplierInvoice {
  id            String                @id @default(uuid())
  invoiceNumber String                @unique
  purchaseOrderId String
  purchaseOrder   PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id])
  supplierId    String
  supplier      Supplier              @relation(fields: [supplierId], references: [id])
  amount        Decimal               @db.Decimal(14, 2)
  dueDate       DateTime?
  status        SupplierInvoiceStatus @default(UNPAID)
  paidDate      DateTime?
  createdAt     DateTime              @default(now())
}

// =========================================================================
// MANUFACTURING
// =========================================================================

model ProductionPlan {
  id        String   @id @default(uuid())
  planDate  DateTime
  notes     String?
  createdById String?
  createdAt DateTime @default(now())

  items ProductionPlanItem[]
}

model ProductionPlanItem {
  id                String         @id @default(uuid())
  productionPlanId  String
  productionPlan    ProductionPlan @relation(fields: [productionPlanId], references: [id], onDelete: Cascade)
  productId         String
  product           Product        @relation(fields: [productId], references: [id])
  plannedQuantity   Decimal        @db.Decimal(12, 3)
}

model ProductionOrder {
  id              String                @id @default(uuid())
  orderNumber     String                @unique
  productId       String
  product         Product               @relation(fields: [productId], references: [id])
  recipeId        String
  recipe          Recipe                @relation(fields: [recipeId], references: [id])
  warehouseId     String // production warehouse
  warehouse       Warehouse             @relation(fields: [warehouseId], references: [id])
  plannedQuantity Decimal               @db.Decimal(12, 3)
  actualYieldQty  Decimal?              @db.Decimal(12, 3)
  status          ProductionOrderStatus @default(PLANNED)
  scheduledDate   DateTime
  startedAt       DateTime?
  completedAt     DateTime?
  operatorId      String?
  operator        User?                 @relation("Operator", fields: [operatorId], references: [id])
  createdById     String?
  createdAt       DateTime              @default(now())

  ingredientIssues ProductionOrderIngredientIssue[]
  batch            FinishedGoodsBatch?

  @@index([status])
}

model ProductionOrderIngredientIssue {
  id                String          @id @default(uuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  rawMaterialId     String
  rawMaterial       RawMaterial     @relation(fields: [rawMaterialId], references: [id])
  rawMaterialLotId  String
  rawMaterialLot    RawMaterialLot  @relation(fields: [rawMaterialLotId], references: [id])
  quantityIssued    Decimal         @db.Decimal(12, 3)
  unit              String
}

// =========================================================================
// CRM / CUSTOMERS / LOYALTY
// =========================================================================

model LoyaltyTier {
  id          String   @id @default(uuid())
  name        String   @unique // e.g. Bronze, Silver, Gold
  minPoints   Int
  discountPct Decimal  @db.Decimal(5, 2) @default(0)
  benefits    String?

  customers Customer[]
}

model Customer {
  id            String       @id @default(uuid())
  name          String
  phone         String?      @unique
  email         String?
  address       String?
  type          CustomerType @default(WALK_IN)
  loyaltyTierId String?
  loyaltyTier   LoyaltyTier? @relation(fields: [loyaltyTierId], references: [id])
  loyaltyPoints Int          @default(0)
  createdAt     DateTime     @default(now())

  sales         Sale[]
  subscriptions Subscription[]
  deliveries    Delivery[]

  @@index([type])
}

model Coupon {
  id             String             @id @default(uuid())
  code           String             @unique
  discountType   CouponDiscountType
  discountValue  Decimal            @db.Decimal(12, 2)
  validFrom      DateTime
  validTo        DateTime
  usageLimit     Int?
  usedCount      Int                @default(0)
  isActive       Boolean            @default(true)

  sales Sale[]
}

// =========================================================================
// POS / SALES
// =========================================================================

model Sale {
  id             String        @id @default(uuid())
  saleNumber     String        @unique
  channel        SaleChannel   @default(WALK_IN)
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  cashierId      String?
  cashier        User?         @relation(fields: [cashierId], references: [id])
  warehouseId    String // outlet / fulfilling warehouse
  warehouse      Warehouse     @relation(fields: [warehouseId], references: [id])
  couponId       String?
  coupon         Coupon?       @relation(fields: [couponId], references: [id])
  subtotal       Decimal       @db.Decimal(14, 2)
  discountAmount Decimal       @db.Decimal(14, 2) @default(0)
  taxAmount      Decimal       @db.Decimal(14, 2) @default(0)
  totalAmount    Decimal       @db.Decimal(14, 2)
  paymentMethod  PaymentMethod
  paymentStatus  PaymentStatus @default(PAID)
  createdAt      DateTime      @default(now())

  items      SaleItem[]
  deliveries Delivery[]

  @@index([channel])
  @@index([createdAt])
}

/// Each line is allocated to a specific batch (FEFO) at time of sale — enables
/// printing batch/production/expiry info on the receipt and full traceability.
model SaleItem {
  id        String              @id @default(uuid())
  saleId    String
  sale      Sale                @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product             @relation(fields: [productId], references: [id])
  batchId   String
  batch     FinishedGoodsBatch  @relation(fields: [batchId], references: [id])
  quantity  Decimal             @db.Decimal(12, 3)
  unitPrice Decimal             @db.Decimal(12, 2)
  discount  Decimal             @db.Decimal(12, 2) @default(0)
  subtotal  Decimal             @db.Decimal(14, 2)

  @@index([batchId])
}

// =========================================================================
// SUBSCRIPTIONS
// =========================================================================

model Subscription {
  id           String                @id @default(uuid())
  customerId   String
  customer     Customer              @relation(fields: [customerId], references: [id])
  name         String
  frequency    SubscriptionFrequency
  dayOfWeek    Int? // 0=Sunday..6=Saturday, for WEEKLY
  dayOfMonth   Int? // for MONTHLY
  status       SubscriptionStatus    @default(ACTIVE)
  startDate    DateTime
  endDate      DateTime?
  nextRunDate  DateTime
  createdAt    DateTime              @default(now())

  items SubscriptionItem[]
}

model SubscriptionItem {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  quantity       Decimal      @db.Decimal(12, 3)
}

// =========================================================================
// MARKETPLACE INTEGRATION (future-ready)
// =========================================================================

model MarketplaceChannel {
  id        String          @id @default(uuid())
  name      MarketplaceName @unique
  isActive  Boolean         @default(false)
  apiConfig Json? // store credentials/config reference (never raw secrets)

  orders MarketplaceOrder[]
}

model MarketplaceOrder {
  id              String              @id @default(uuid())
  channelId       String
  channel         MarketplaceChannel  @relation(fields: [channelId], references: [id])
  externalOrderId String
  saleId          String?
  status          String
  rawPayload      Json?
  syncedAt        DateTime            @default(now())

  @@unique([channelId, externalOrderId])
}

// =========================================================================
// DELIVERY
// =========================================================================

model Vehicle {
  id          String   @id @default(uuid())
  plateNumber String   @unique
  type        String?
  isActive    Boolean  @default(true)

  deliveries Delivery[]
}

model Delivery {
  id             String         @id @default(uuid())
  deliveryNumber String         @unique
  saleId         String?
  sale           Sale?          @relation(fields: [saleId], references: [id])
  subscriptionId String?
  customerId     String
  customer       Customer       @relation(fields: [customerId], references: [id])
  driverId       String?
  driver         User?          @relation("DriverUser", fields: [driverId], references: [id])
  vehicleId      String?
  vehicle        Vehicle?       @relation(fields: [vehicleId], references: [id])
  route          String?
  status         DeliveryStatus @default(SCHEDULED)
  scheduledDate  DateTime
  deliveredAt    DateTime?
  notes          String?
  createdAt      DateTime       @default(now())

  @@index([status])
}

// =========================================================================
// WASTE MANAGEMENT
// =========================================================================

model WasteRecord {
  id                   String      @id @default(uuid())
  type                 WasteType
  rawMaterialId        String?
  rawMaterial          RawMaterial? @relation(fields: [rawMaterialId], references: [id])
  rawMaterialLotId     String?
  rawMaterialLot       RawMaterialLot? @relation(fields: [rawMaterialLotId], references: [id])
  finishedGoodsBatchId String?
  finishedGoodsBatch   FinishedGoodsBatch? @relation(fields: [finishedGoodsBatchId], references: [id])
  quantity             Decimal     @db.Decimal(12, 3)
  unit                 String
  reason               WasteReason
  estimatedValue       Decimal     @db.Decimal(14, 2)
  recordedById         String?
  recordedBy           User?       @relation(fields: [recordedById], references: [id])
  note                 String?
  recordedAt           DateTime    @default(now())

  @@index([type, recordedAt])
}

// =========================================================================
// ACCOUNTING
// =========================================================================

model Account {
  id       String      @id @default(uuid())
  code     String      @unique
  name     String
  type     AccountType
  parentId String?
  parent   Account?    @relation("AccountHierarchy", fields: [parentId], references: [id])
  children Account[]   @relation("AccountHierarchy")

  journalLines JournalLine[]
}

model JournalEntry {
  id          String            @id @default(uuid())
  entryNumber String            @unique
  date        DateTime          @default(now())
  sourceType  JournalSourceType
  sourceId    String? // e.g. Sale.id, PurchaseOrder.id, ProductionOrder.id, WasteRecord.id
  description String?
  createdById String?
  createdBy   User?             @relation(fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())

  lines JournalLine[]

  @@index([sourceType, sourceId])
}

model JournalLine {
  id             String       @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  debit          Decimal      @db.Decimal(14, 2) @default(0)
  credit         Decimal      @db.Decimal(14, 2) @default(0)
  description    String?

  @@index([accountId])
}
